##################################################
# JAGS model for an IPM-like model with
# Beverton-Holt fecundity filtered by a transition
# probability from seed to germination stages
##################################################

model {

  ###########################
  # Likelihood
  ###########################
  for(t in 1:N){

    # growth determined by log-linear model
    lambda[t] = exp(inprod(X_alpha[t,], alpha))

    # expected fecundity
    mu[t] = (vm[t] * lambda) / (1 + exp(inprod(X_beta[t, ], beta))

    # fecundity model
    f[t] ~ dpois(mu[t])

    # survival filter
    vp[t] ~ dbinom(f[t], p)

  }


  ########################
  # Priors
  ########################
  slab_scl2 = pow(slab_scl, 2)
  half_slab_df = 0.5 * slab_df

  # scale the slab
  c2 = slab_scl2 * c2_std
  c2_std = 1 / c2_std_inv
  c2_std_inv ~ dgamma(half_slab_df, half_slab_df)

  # scale tau
  tau = tau_std * tau0
  tau_std ~ dt(0, 1, 1)T(0, )

  # scale the betas
  for(i in 1:P){
    local_scl_tilde[i] = sqrt(c2 * pow(local_scl[i], 2) / (c2 + pow(tau, 2) * pow(local_scl[i], 2)))
    beta[i] = tau * local_scl_tilde[i] * beta_std[i]
    beta_std[i] ~ dnorm(0, 1)
    local_scl[i] ~ dt(0, 1, 1)T(0, )
  }

  for(i in 1:P0){
    alpha[i] = 5 * alpha_std[i]
    alpha_std[i] ~ dnorm(0, 1)
  }

  p ~ dbeta(1, 1)

}
